{
  "name": "ai-code-assist",
  "displayName": "AI Code Assist",
  "description": "Your AI-powered coding assistant for chat, agent tasks, and more.",
  "version": "0.1.0",
  "publisher": "YourPublisherName",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/ai-code-generator.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiCodeAssist.setToken",
        "title": "AI Code Assist: Set Auth Token",
        "category": "AI Code Assist"
      },
      {
        "command": "aiCodeAssist.acceptChange",
        "title": "Accept AI Change"
      },
      {
        "command": "aiCodeAssist.rejectChange",
        "title": "Reject AI Change"
      },
      {
        "command": "aiCodeAssist.acceptAllChanges",
        "title": "Accept All AI Changes"
      },
      {
        "command": "aiCodeAssist.rejectAllChanges",
        "title": "Reject All AI Changes"
      },
      {
        "command": "ai-code-assist.openChat",
        "title": "Open AI Code Assist Chat (Disabled in SWE-bench mode)"
      },
      {
        "command": "ai-code-assist.toggleSuggestions",
        "title": "Toggle AI Suggestions"
      }
    ],
    "outputChannels": [
      "AI code assist"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run esbuild-base -- --minify",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.10",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
  "@huggingface/transformers": "^3.5.1",
  "@lancedb/lancedb": "^0.19.1",
  "apache-arrow": "^18.0.0",
  "dotenv": "^16.4.7",
  "node-fetch": "^3.3.2",
  "tree-sitter": "^0.21.1",
  "tree-sitter-java": "^0.23.5",
  "tree-sitter-javascript": "^0.23.1",
  "tree-sitter-typescript": "^0.23.2"
  }
}