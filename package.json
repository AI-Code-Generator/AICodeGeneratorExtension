{
  "name": "ai-code-assist",
  "displayName": "ai-code-assist",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-code-assist",
          "title": "AI Code Assistant",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-code-assist": [
        {
          "type": "webview",
          "id": "aiCodeAssist.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-code-assist.openChat",
        "title": "Open AI Chat"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && webpack --mode production",
    "compile": "webpack --mode none",
    "watch": "webpack --mode none --watch",
    "package": "npm run vscode:prepublish && vsce package --no-pre-publish",
    "clean": "rimraf dist out",
    "postinstall": "node ./scripts/prune-onnx.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.19.0",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.7.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "@lancedb/lancedb": "^0.19.1",
    "apache-arrow": "^18.0.0",
    "dotenv": "^16.4.7",
    "node-fetch": "^3.3.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  }
}
